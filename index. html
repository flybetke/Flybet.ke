<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>FLY BET - Aviator Kenya</title>
<style>*{box-sizing:border-box}body{margin:0;background:#0a0a0a;color:#fff;font-family:Arial}button{cursor:pointer;color:#fff}input{color:#000}
.top{display:flex;justify-content:space-between;align-items:center;background:#111;padding:10px;position:sticky;top:0;z-index:20}
.logo{color:red;font-weight:900;font-size:22px}.bal{color:#22c55e;font-weight:900}
.depBtn{background:#22c55e;border:none;padding:8px 14px;border-radius:8px;font-weight:900;color:#000}
.layout{display:flex;gap:10px;padding:0 5px}.main{flex:1}.side{width:320px}@media(max-width:800px){.layout{flex-direction:column}.side{width:100%}}
.game{background:#000;height:260px;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;overflow:hidden;border-radius:16px;margin:10px 0}
#multiplier{font-size:52px;font-weight:900;z-index:2}#plane{font-size:50px;position:absolute;left:20px;bottom:20px}
.panel{background:#1a1a1a;margin:10px;border-radius:16px;padding:12px}.flex{display:flex;gap:10px}
.amtCtrl{display:flex;justify-content:space-between;background:#000;border-radius:20px;padding:6px 10px}.amtCtrl button{background:#222;border:none;width:32px;height:32px;border-radius:50%;font-size:20px}
.quick{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:8px}.quick button{background:#222;border:none;padding:8px;border-radius:8px}
.betBtn{flex:1;background:#22c55e;border:none;border-radius:12px;font-size:22px;font-weight:900}.auth input{width:100%;padding:10px;margin-bottom:8px;border-radius:8px;border:none}.auth button{width:100%;padding:12px;border:none;border-radius:8px;font-weight:900}.hidden{display:none!important}</style></head>
<body>
<div class="top"><div class="logo">✈️ FLYBET</div><div style="display:flex;gap:10px;align-items:center"><span class="bal" id="balance">0.00 KES</span><button class="depBtn" onclick="document.getElementById('depositPanel').scrollIntoView({behavior:'smooth'})">+ DEPOSIT</button></div></div>
<div class="layout"><div class="main">
<div class="panel auth" id="auth"><h3>Login / Register</h3>
<div style="display:flex;gap:8px;margin-bottom:10px"><button id="loginTab" onclick="setAuth('login')" style="background:#22c55e;color:#000">Login</button><button id="regTab" onclick="setAuth('register')" style="background:#333">Register</button></div>
<input id="username" placeholder="Username"><input id="phone" placeholder="+254712345678" value="+254"><input id="password" type="password" placeholder="Password">
<button onclick="accountAction()" id="authBtn" style="background:#22c55e;color:#000">Continue</button><p style="font-size:12px;color:#aaa">Phone must start with +254</p></div>
<div class="game"><div id="historyBar" style="display:flex;gap:6px;overflow-x:auto;padding:8px;position:absolute;top:8px;left:8px;right:8px;z-index:3"></div><div id="plane">✈️</div><div id="multiplier">1.00x</div><div id="gameStatus" style="color:#aaa">Waiting...</div><button id="cashBtn" onclick="cashOut()" style="display:none;background:#facc15;color:#000;border:none;padding:10px 20px;border-radius:10px;font-weight:900;margin-top:10px;z-index:3">CASH OUT</button></div>
<div class="panel"><div class="flex"><div style="flex:1"><div class="amtCtrl"><button onclick="changeBet(1,-10)">−</button><span id="betAmount1" style="font-weight:900;font-size:20px">50.00</span><button onclick="changeBet(1,10)">+</button></div><div class="quick"><button onclick="setBet(1,50)">50</button><button onclick="setBet(1,100)">100</button><button onclick="setBet(1,250)">250</button><button onclick="setBet(1,1000)">1,000</button></div></div><button class="betBtn" onclick="placeBet(1)" id="betBtn1">Bet<br><small id="betBtnText1">50.00 KES</small></button></div></div>
<div class="panel"><div class="flex"><div style="flex:1"><div class="amtCtrl"><button onclick="changeBet(2,-10)">−</button><span id="betAmount2" style="font-weight:900;font-size:20px">50.00</span><button onclick="changeBet(2,10)">+</button></div><div class="quick"><button onclick="setBet(2,50)">50</button><button onclick="setBet(2,100)">100</button><button onclick="setBet(2,250)">250</button><button onclick="setBet(2,1000)">1,000</button></div></div><button class="betBtn" onclick="placeBet(2)" id="betBtn2">Bet<br><small id="betBtnText2">50.00 KES</small></button></div></div>
<div class="panel"><p>ALL BETS - <span id="totalBets">0</span></p><div id="betsList"></div></div></div>
<div class="side"><div class="panel" id="depositPanel" style="border:1px solid #22c55e"><h3 style="color:#22c55e">💰 DEPOSIT</h3><p style="font-size:13px;color:#ccc">Min: <b>100 KES</b> - M-Pesa STK Push - Paybill 1364630</p>
<input id="depositAmount" type="number" placeholder="Amount e.g. 100" style="width:100%;padding:10px;margin-bottom:8px;border-radius:8px;border:none"><input id="depositPhone" placeholder="+254712345678" style="width:100%;padding:10px;margin-bottom:8px;border-radius:8px;border:none">
<button onclick="depositAction()" style="width:100%;padding:12px;background:#22c55e;color:#000;font-weight:900;border:none;border-radius:8px">DEPOSIT NOW</button><p id="depositMsg" style="font-size:12px;color:#aaa"></p>
<p style="font-size:12px;color:#888">1. Amount min 100<br>2. Phone +254...<br>3. DEPOSIT NOW<br>4. Enter M-Pesa PIN<br>5. Balance updates</p></div>
<div class="panel"><h4>How to Play</h4><p style="font-size:13px;color:#aaa">Min Bet 50 KES<br>Place bet > Plane flies > Cash out before crash!</p></div></div></div>
<script>
let authMode="login",balance=0,bets1=50,bets2=50,activeBet=null,currentMult=1,phase="waiting",history=[],timer=null;
function updBal(){document.getElementById("balance").textContent=balance.toFixed(2)+" KES"}
function setAuth(m){authMode=m;document.getElementById("loginTab").style.background=m=="login"?"#22c55e":"#333";document.getElementById("regTab").style.background=m=="register"?"#22c55e":"#333";document.getElementById("authBtn").textContent=m=="login"?"Login":"Register"}
function setBet(n,v){if(n==1){bets1=v;document.getElementById("betAmount1").textContent=v.toFixed(2);document.getElementById("betBtnText1").textContent=v.toFixed(2)+" KES"}else{bets2=v;document.getElementById("betAmount2").textContent=v.toFixed(2);document.getElementById("betBtnText2").textContent=v.toFixed(2)+" KES"}}
function changeBet(n,d){if(n==1)setBet(1,Math.max(50,bets1+d));else setBet(2,Math.max(50,bets2+d))}
function norm(p){p=p.trim();if(p.startsWith("+254"))return p;if(p.startsWith("254"))return "+"+p;if(p.startsWith("0"))return "+254"+p.slice(1);return p}
async function accountAction(){
  let username=document.getElementById("username").value.trim(),phone=norm(document.getElementById("phone").value),password=document.getElementById("password").value;
  if(!/^\+254[17]\d{8}$/.test(phone)){alert("Phone must be +2547... or +2541...");return}
  if(!username||!password){alert("Fill all fields");return}
  const url=authMode=="login"?"/api/login":"/api/register";
  const res=await fetch(url,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({username,phone,password})});
  const d=await res.json(); if(!res.ok){alert(d.error);return}
  localStorage.setItem("flybet_token",d.token); balance=d.balance||0; updBal();
  alert(authMode=="login"?"Logged in":"Account created"); document.getElementById("auth").classList.add("hidden");
  document.getElementById("depositPhone").value=phone;
}
async function depositAction(){
  let amount=parseInt(document.getElementById("depositAmount").value),phone=norm(document.getElementById("depositPhone").value);
  if(!amount||amount<100){alert("Min 100");return}
  if(!/^\+254[17]\d{8}$/.test(phone)){alert("Phone must be +254...");return}
  const token=localStorage.getItem("flybet_token"); if(!token){alert("Login first");return}
  document.getElementById("depositMsg").textContent="Sending STK to "+phone+"...";
  const res=await fetch("/api/deposit",{method:"POST",headers:{"Content-Type":"application/json","Authorization":"Bearer "+token},body:JSON.stringify({amount,phone})});
  const d=await res.json(); if(!res.ok){alert(d.error);return}
  document.getElementById("depositMsg").textContent="✅ STK sent! Enter PIN on phone.";
  setTimeout(async()=>{const r=await fetch("/api/me",{headers:{Authorization:"Bearer "+token}});const j=await r.json();if(j.balance!==undefined){balance=j.balance;updBal()}},15000);
}
function placeBet(n){const amt=n==1?bets1:bets2;if(balance<amt){alert("Low balance. Deposit first.");return}if(phase!=="waiting"){alert("Wait for next round");return}if(activeBet){alert("Already bet this round");return}balance-=amt;updBal();activeBet={amt,slot:n};document.getElementById("betBtn"+n).textContent="Waiting..."}
function updHist(){document.getElementById("historyBar").innerHTML=history.slice(0,8).map(h=>{let c=h<2?"#ef4444":h<5?"#facc15":"#22c55e";return `<span style="background:#222;color:${c};padding:4px 8px;border-radius:20px;font-size:12px">${h.toFixed(2)}x</span>`}).join("")}
function startWaiting(){phase="waiting";currentMult=1;document.getElementById("multiplier").textContent="1.00x";document.getElementById("multiplier").style.color="#fff";document.getElementById("plane").textContent="✈️";document.getElementById("plane").style.left="20px";document.getElementById("plane").style.bottom="20px";document.getElementById("cashBtn").style.display="none";resetBtns();let c=5;document.getElementById("gameStatus").textContent="Next flight in "+c+"... Place bet!";let w=setInterval(()=>{c--;if(c<=0){clearInterval(w);startGame()}else document.getElementById("gameStatus").textContent="Next flight in "+c+"... Place bet!"},1000)}
function startGame(){phase="flying";currentMult=1;let crash=1.2+Math.random()*5;document.getElementById("gameStatus").textContent="Flying...";document.getElementById("gameStatus").style.color="#22c55e";if(activeBet)document.getElementById("cashBtn").style.display="block";timer=setInterval(()=>{currentMult+=0.05;document.getElementById("multiplier").textContent=currentMult.toFixed(2)+"x";document.getElementById("multiplier").style.color="#22c55e";let px=20+currentMult*10,py=20+currentMult*8;if(px>280)px=280;if(py>180)py=180;document.getElementById("plane").style.left=px+"px";document.getElementById("plane").style.bottom=py+"px";if(currentMult>=crash){clearInterval(timer);phase="crashed";history.unshift(currentMult);updHist();document.getElementById("gameStatus").textContent="💥 Crashed at "+currentMult.toFixed(2)+"x";document.getElementById("gameStatus").style.color="#ef4444";document.getElementById("multiplier").style.color="#ef4444";document.getElementById("plane").textContent="💥";document.getElementById("cashBtn").style.display="none";if(activeBet){addRow(activeBet.amt,currentMult,0);activeBet=null}setTimeout(startWaiting,3000)}},100)}
function cashOut(){if(!activeBet||phase!=="flying")return;const win=Math.floor(activeBet.amt*currentMult);balance+=win;updBal();addRow(activeBet.amt,currentMult,win);document.getElementById("gameStatus").textContent="✅ Cashed out "+currentMult.toFixed(2)+"x - Won "+win;document.getElementById("cashBtn").style.display="none";activeBet=null}
function resetBtns(){document.getElementById("betBtn1").innerHTML='Bet<br><small id="betBtnText1">'+bets1.toFixed(2)+' KES</small>';document.getElementById("betBtn2").innerHTML='Bet<br><small id="betBtnText2">'+bets2.toFixed(2)+' KES</small>'}
function addRow(amt,mult,win){const l=document.getElementById("betsList");const d=document.createElement("div");d.style.cssText="display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid #222";d.innerHTML="<span>You</span><span>"+amt+"</span><span>"+mult.toFixed(2)+"x</span><span style='color:"+(win>0?"#22c55e":"#f00")+"'>"+win+"</span>";l.prepend(d);document.getElementById("totalBets").textContent=parseInt(document.getElementById("totalBets").textContent)+1}
startWaiting();
</script></body></html>
